  <PropertyGroup>
    <!-- mdmerge 不能可靠处理非 ASCII 响应文件路径。发行脚本要求源码位于纯 ASCII 路径，
         因而可把所有 CppWinRT 中间文件和输出保留在源码 artifacts 内。 -->
    <RillshotBuildRoot Condition="'$(RillshotBuildRoot)'==''">$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\artifacts\build\winui-intermediate'))</RillshotBuildRoot>
    <OutDir>$(RillshotBuildRoot)\$(ProjectName)\$(RillshotDistribution)\$(Platform)\$(Configuration)\bin\</OutDir>
    <IntDir>$(RillshotBuildRoot)\$(ProjectName)\$(RillshotDistribution)\$(Platform)\$(Configuration)\obj\</IntDir>
  </PropertyGroup>

  <ItemDefinitionGroup>
