root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cpp,h}]
indent_style = space
indent_size = 4

[*.{json,mjs,xaml,xml,vcxproj,props,manifest,appxmanifest}]
indent_style = space
indent_size = 2

[*.{ps1,cmd}]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
